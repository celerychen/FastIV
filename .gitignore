# ===== FastIV .gitignore =====

# Per user request: reference code is excluded from this repo (matches at any depth)
src/reference/

# Per user request: qwen_from_scratch is excluded from this push (matches at any depth)
qwen_from_scratch/

# Build intermediates
obj/
*.exe
*.obj
*.o
*.log
build/test_*

# Agent / local tooling memory (not project source)
.workbuddy/

# OS junk
.DS_Store
Thumbs.db

# Large binary assets excluded from git (kept on disk)
*.zip
*.jpg
*.jpeg
*.png
*.gif

# API push temp scripts (contain token, never commit)
_api_push.*
_push.log
_b.json
_c.json
_r.json
_tree.json
_tree_entries.jsonl
